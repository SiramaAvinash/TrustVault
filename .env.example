# Local development defaults. Generate a unique JWT secret for each deployment.
ENVIRONMENT=development
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///./trustvault.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
ACCESS_TOKEN_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173

# Google Identity Services: use the same Web OAuth client ID in frontend and backend.
GOOGLE_CLIENT_ID=
# Email is optional. If enabled, use Resend (the application currently sends email via Resend's HTTPS API).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Set true only when an email provider is configured and every login should require email OTP.
LOGIN_OTP_EVERY_TIME=false
